# Biến môi trường khi chạy trên máy local — chép thành .env.local rồi điền.
# Trên Firebase App Hosting các giá trị này khai báo trong apphosting.yaml.

# === Google Sheet nguồn ===
SPREADSHEET_ID=
EMPLOYEE_SHEET_NAME=Nhân viên
COMPANY_SHEET_NAME=Công ty
# JSON key (viết trên 1 dòng) của tài khoản dịch vụ có quyền xem Sheet.
# Bỏ trống trên Firebase: app dùng tài khoản dịch vụ của backend.
SERVICE_ACCOUNT_JSON=

# === Firebase (cấu hình web, định danh công khai) ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Chạy thử với Firebase Emulator (firebase emulators:start) ===
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# === Sinh PDF ===
# Đường dẫn Chrome (tùy chọn). Bỏ trống: tự tìm Chrome cài sẵn; trên Firebase dùng @sparticuz/chromium.
CHROME_PATH=
